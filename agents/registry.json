{
  "version": "0.1.1",
  "source": "legacy_p0_cleaned",
  "note": "Cleaned legacy OnePal agent registry. Architecture source of truth is docs/freeze/AI_Workbench_Architecture_Freeze_v0.1.1-final.md.",
  "agents": [
    {
      "id": "coordinator",
      "name": "Coordinator",
      "role": "统一入口与协调",
      "responsibilities": "接收用户请求，结构化意图，判断风险，路由到对应 Agent，管理 proposal、approval 和 task tree。",
      "inputs": ["user_request", "task_tree", "route_table"],
      "outputs": ["agent_task", "approval_request", "response_summary"],
      "risk_level": "medium",
      "default_model": "deepseek/deepseek-v4-pro",
      "can_execute": false,
      "requires_approval": false,
      "status": "active"
    },
    {
      "id": "memory_curator",
      "name": "Memory Curator",
      "role": "记忆治理",
      "responsibilities": "管理长期记忆候选、审核、合并、归档、冲突处理和记忆清理提案。不得绕过 approval 写入正式 memory。",
      "inputs": ["memory_candidate", "query", "user_decision"],
      "outputs": ["memory_entry", "archive_entry", "proposal_status"],
      "risk_level": "medium",
      "default_model": "deepseek/deepseek-v4-pro",
      "can_execute": false,
      "requires_approval": true,
      "status": "active"
    },
    {
      "id": "opencode_builder",
      "name": "OpenCode Builder",
      "role": "工程实现",
      "responsibilities": "在审批后的任务范围内执行代码修改、文件创建、脚本实现、Dashboard/API/测试落地，并输出验证方法和回滚方式。",
      "inputs": ["change_request", "spec", "verification_criteria"],
      "outputs": ["code_change", "file_create", "test_result"],
      "risk_level": "high",
      "default_model": "deepseek/deepseek-v4-pro",
      "can_execute": true,
      "requires_approval": true,
      "status": "active"
    },
    {
      "id": "capability_hr",
      "name": "Capability HR",
      "role": "能力招聘与 Skill 生命周期",
      "responsibilities": "评估外部工具、Skill、workflow、feature 和 framework 候选，管理候选池、sandbox、skill package 与能力淘汰。",
      "inputs": ["research_packet", "candidate_repo", "skill_candidate"],
      "outputs": ["capability_evaluation", "candidate_entry", "onboarding_proposal"],
      "risk_level": "medium",
      "default_model": "deepseek/deepseek-v4-pro",
      "can_execute": false,
      "requires_approval": true,
      "status": "active"
    },
    {
      "id": "automation_input_manager",
      "name": "Automation & Input Manager",
      "role": "自动化与输入治理",
      "responsibilities": "处理文件输入、Document Packet、n8n workflow 调度、定时任务、转换日志和系统健康触发。n8n 只负责敲钟，不绕过审批。",
      "inputs": ["document", "schedule_config", "file_event"],
      "outputs": ["document_packet", "workflow_run", "log_entry"],
      "risk_level": "medium",
      "default_model": "deepseek/deepseek-v4-flash",
      "can_execute": false,
      "requires_approval": true,
      "status": "active"
    },
    {
      "id": "research_scout",
      "name": "Research Scout",
      "role": "外部搜索与 Research Packet",
      "responsibilities": "执行外部搜索、趋势扫描、来源初筛、去重、轻摘要和 Research Packet 生成。不得直接安装项目或写入正式状态。",
      "inputs": ["query", "source_list", "search_params"],
      "outputs": ["research_packet", "source_evaluation", "research_handoff"],
      "risk_level": "low",
      "default_model": "deepseek/deepseek-v4-flash",
      "can_execute": false,
      "requires_approval": false,
      "status": "active"
    },
    {
      "id": "deep_research_cognition",
      "name": "Deep Research & Cognition",
      "role": "深度研究与认知拓展",
      "responsibilities": "基于 Research Packet 进行深度综合、观点辨析、认知卡片生成和知识图谱候选更新。Tutor 是子能力，不是正式 Agent 名称。",
      "inputs": ["research_packet", "topic", "context"],
      "outputs": ["research_brief", "cognition_card", "knowledge_graph_candidate"],
      "risk_level": "low",
      "default_model": "deepseek/deepseek-v4-pro",
      "can_execute": false,
      "requires_approval": false,
      "status": "active"
    },
    {
      "id": "growth_planner",
      "name": "Growth Planner",
      "role": "学习计划与成长规划",
      "responsibilities": "把明确目标、模糊成长需求、能力缺口转化为 Goal Contract、Capacity Model、周任务和复盘。不得替代 Agent 7 讲知识。",
      "inputs": ["goal_candidate", "progress_data", "review_request"],
      "outputs": ["goal_contract", "task_schedule", "progress_review"],
      "risk_level": "low",
      "default_model": "deepseek/deepseek-v4-pro",
      "can_execute": false,
      "requires_approval": false,
      "status": "active"
    },
    {
      "id": "career_asset_agent",
      "name": "Career Asset Agent",
      "role": "职业资产与 JD",
      "responsibilities": "管理真实职业资产、Resume Claim、JD 评估、简历定制计划和求职表。不得虚构经历、自动投递或自动发送邮件。",
      "inputs": ["career_asset", "resume_claim", "jd"],
      "outputs": ["jd_evaluation", "resume_customization_plan", "application_record"],
      "risk_level": "high",
      "default_model": "deepseek/deepseek-v4-pro",
      "can_execute": false,
      "requires_approval": true,
      "status": "active"
    }
  ]
}
