{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://ai-workbench.local/schemas/core/knowledge_node.schema.json",
  "title": "Knowledge Node",
  "type": "object",
  "additionalProperties": false,
  "required": ["node_id", "node_type", "label", "source_refs", "confidence", "status", "created_at"],
  "properties": {
    "node_id": {"type": "string", "pattern": "^knode_[a-zA-Z0-9_.-]+$"},
    "node_type": {"type": "string", "enum": ["concept", "memory", "research", "career", "growth", "skill", "workflow", "other"]},
    "label": {"type": "string", "minLength": 1},
    "summary": {"type": ["string", "null"]},
    "source_refs": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "status": {"type": "string", "enum": ["candidate", "active", "archived"]},
    "created_at": {"type": "string"}
  }
}
