{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-workbench.local/schemas/core/smoke_test.schema.json",
  "title": "Smoke Test",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "smoke_test_id",
    "profile",
    "trigger",
    "overall_status",
    "checks",
    "created_at"
  ],
  "properties": {
    "smoke_test_id": {
      "type": "string",
      "pattern": "^smoke_[a-zA-Z0-9_.-]+$"
    },
    "profile": {
      "type": "string",
      "enum": [
        "first-run",
        "dev-local",
        "test-local",
        "prod-local",
        "safe-mode"
      ]
    },
    "trigger": {
      "type": "string",
      "enum": [
        "startup",
        "deployment",
        "rollback",
        "scheduled",
        "manual"
      ]
    },
    "overall_status": {
      "type": "string",
      "enum": [
        "ready",
        "limited_ready",
        "not_ready",
        "safe_mode"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "name",
          "severity",
          "status"
        ],
        "properties": {
          "check_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "warning",
              "info"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "skipped",
              "warning"
            ]
          },
          "details_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "created_at": {
      "type": "string"
    }
  }
}
