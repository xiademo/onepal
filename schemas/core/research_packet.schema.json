{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://ai-workbench.local/schemas/core/research_packet.schema.json",
  "title": "Research Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "research_packet_id",
    "query",
    "source_refs",
    "source_evaluation_refs",
    "summary",
    "created_at"
  ],
  "properties": {
    "research_packet_id": {
      "type": "string",
      "pattern": "^respkt_[a-zA-Z0-9_.-]+$"
    },
    "query": {
      "type": "string"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_evaluation_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_pack_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    },
    "freshness_required": {
      "type": "boolean"
    },
    "untrusted_instruction_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
