{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-workbench.local/schemas/core/memory_candidate.schema.json",
  "title": "Memory Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "memory_candidate_id",
    "memory_type",
    "summary",
    "source",
    "origin_type",
    "status",
    "sensitivity",
    "confidence",
    "requires_user_confirmation",
    "created_at"
  ],
  "properties": {
    "memory_candidate_id": {
      "type": "string",
      "pattern": "^memcand_[a-zA-Z0-9_.-]+$"
    },
    "memory_type": {
      "type": "string",
      "enum": [
        "user_preference",
        "system_decision",
        "learning_interest",
        "career_preference",
        "workflow_preference",
        "safety_rule",
        "other"
      ]
    },
    "summary": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "origin_type": {
      "type": "string",
      "enum": [
        "user_direct",
        "user_confirmed",
        "agent_inferred",
        "external_source",
        "system_generated"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflict_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "requires_user_confirmation": {
      "type": "boolean"
    },
    "promotion_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "expiry_policy": {
      "type": "string",
      "enum": [
        "none",
        "review_30d",
        "review_90d",
        "expires_30d",
        "expires_90d",
        "permanent_review_required"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_review",
        "approved",
        "rejected",
        "merged",
        "expired",
        "writing",
        "active",
        "failed",
        "archived",
        "superseded"
      ]
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "private",
        "sensitive"
      ]
    },
    "retention": {
      "type": "string",
      "enum": [
        "short",
        "medium",
        "long",
        "permanent_review_required"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "origin_type": {
            "enum": [
              "agent_inferred",
              "external_source"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "requires_user_confirmation": {
            "const": true
          }
        },
        "required": [
          "requires_user_confirmation"
        ]
      }
    }
  ]
}
