# Python / Node common
__pycache__/
*.pyc
node_modules/
dist/
build/

# OpenCode runtime state
.omo/

# Local runtime state
runtime/*.lock
runtime/*.tmp
runtime/smoke_tests.jsonl
runtime/*.jsonl
runtime/**/*.jsonl
runtime/**/test_*.jsonl
runtime/health_status.json
runtime/runtime_lock.json
runtime/write_mode.json
runtime/smoke_tests/*.jsonl

# Never commit private runtime data
runtime-data-private/
artifact-backup/

# Local env / secrets
.env
.env.*
*.key
*.pem
*.p12
*.pfx
secrets/
tokens/
credentials/

# Runtime logs must not be committed
logs/
