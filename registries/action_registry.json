{
  "version": "1.1.0",
  "actions": [
    {
      "action_id": "action.read_file",
      "name": "Read Project File",
      "category": "read_only",
      "description": "Read a non-sensitive file within the OnePal project directory. No write or external network access.",
      "owner_agent": "coordinator",
      "executor": "file_reader",
      "tool_adapter_ref": null,
      "tool_trust_level": "trusted_internal_tool",
      "input_schema_ref": null,
      "output_schema_ref": null,
      "permission_required": "safe_readonly",
      "risk_level": "R0",
      "state_mutation": false,
      "external_effect": false,
      "approval_required": false,
      "two_step_confirmation_required": false,
      "dry_run_supported": true,
      "rollback_supported": false,
      "idempotency_key_required": false,
      "audit_required": false,
      "allowed_profiles": [
        "safe_readonly",
        "local_write_with_approval"
      ],
      "allowed_write_modes": [
        "read_only"
      ],
      "rate_limit": {
        "max_per_minute": 120
      },
      "timeout_seconds": 10,
      "log_redaction_policy": "reference_only",
      "enabled": true
    },
    {
      "action_id": "action.create_proposal",
